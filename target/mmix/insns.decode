#
# MMIX instruction decode definitions.
#
# SPDX-License-Identifier: LGPL-2.1-or-later
#

&xyz            x y z yz xyz

%yz             0:16
%xyz            0:24

@xyz            ........ x:8 y:8 z:8                  &xyz yz=%yz xyz=%xyz

####
# Trap and no-op placeholders
####

TRAP            00000000 ........ ........ ........    @xyz
SWYM            11111101 ........ ........ ........    @xyz
TRIP            11111111 ........ ........ ........    @xyz

####
# Integer arithmetic
####

ADD             00100000 ........ ........ ........    @xyz
ADDI            00100001 ........ ........ ........    @xyz
ADDU            00100010 ........ ........ ........    @xyz
ADDUI           00100011 ........ ........ ........    @xyz
SUB             00100100 ........ ........ ........    @xyz
SUBI            00100101 ........ ........ ........    @xyz
SUBU            00100110 ........ ........ ........    @xyz
SUBUI           00100111 ........ ........ ........    @xyz
TWO_ADDU        00101000 ........ ........ ........    @xyz
TWO_ADDUI       00101001 ........ ........ ........    @xyz
FOUR_ADDU       00101010 ........ ........ ........    @xyz
FOUR_ADDUI      00101011 ........ ........ ........    @xyz
EIGHT_ADDU      00101100 ........ ........ ........    @xyz
EIGHT_ADDUI     00101101 ........ ........ ........    @xyz
SIXTEEN_ADDU    00101110 ........ ........ ........    @xyz
SIXTEEN_ADDUI   00101111 ........ ........ ........    @xyz

####
# Comparisons
####

CMP             00110000 ........ ........ ........    @xyz
CMPI            00110001 ........ ........ ........    @xyz
CMPU            00110010 ........ ........ ........    @xyz
CMPUI           00110011 ........ ........ ........    @xyz

####
# Conditional branches
####

BZ              01000010 ........ ........ ........    @xyz
BZB             01000011 ........ ........ ........    @xyz
BNZ             01001010 ........ ........ ........    @xyz
BNZB            01001011 ........ ........ ........    @xyz
PBZ             01010010 ........ ........ ........    @xyz
PBZB            01010011 ........ ........ ........    @xyz
PBNZ            01011010 ........ ........ ........    @xyz
PBNZB           01011011 ........ ........ ........    @xyz

####
# Load/store
####

LDO             10001100 ........ ........ ........    @xyz
LDOI            10001101 ........ ........ ........    @xyz
LDOU            10001110 ........ ........ ........    @xyz
LDOUI           10001111 ........ ........ ........    @xyz
STO             10101100 ........ ........ ........    @xyz
STOI            10101101 ........ ........ ........    @xyz
STOU            10101110 ........ ........ ........    @xyz
STOUI           10101111 ........ ........ ........    @xyz

####
# Logical operations
####

OR              11000000 ........ ........ ........    @xyz
ORI             11000001 ........ ........ ........    @xyz
ORN             11000010 ........ ........ ........    @xyz
ORNI            11000011 ........ ........ ........    @xyz
NOR             11000100 ........ ........ ........    @xyz
NORI            11000101 ........ ........ ........    @xyz
XOR             11000110 ........ ........ ........    @xyz
XORI            11000111 ........ ........ ........    @xyz
AND             11001000 ........ ........ ........    @xyz
ANDI            11001001 ........ ........ ........    @xyz
ANDN            11001010 ........ ........ ........    @xyz
ANDNI           11001011 ........ ........ ........    @xyz
NAND            11001100 ........ ........ ........    @xyz
NANDI           11001101 ........ ........ ........    @xyz
NXOR            11001110 ........ ........ ........    @xyz
NXORI           11001111 ........ ........ ........    @xyz

####
# Immediate wyde operations
####

SETH            11100000 ........ ........ ........    @xyz
SETMH           11100001 ........ ........ ........    @xyz
SETML           11100010 ........ ........ ........    @xyz
SETL            11100011 ........ ........ ........    @xyz
INCH            11100100 ........ ........ ........    @xyz
INCMH           11100101 ........ ........ ........    @xyz
INCML           11100110 ........ ........ ........    @xyz
INCL            11100111 ........ ........ ........    @xyz
